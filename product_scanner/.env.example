# Product Tag Scanner & Official Product Image Finder - Environment Configuration
# Copy this file to .env and fill in your keys.

# Gemini Vision LLM (free tier - https://aistudio.google.com/)
GEMINI_API_KEY=

# Serper.dev Search (Google Web & Image Search - https://serper.dev/)
SERPER_API_KEY=

# Brave Search API (Web & Image Search - https://brave.com/search/api/)
BRAVE_API_KEY=

# Tavily Search API (AI Search & Fallback - https://app.tavily.com/)
TAVILY_API_KEY=

# Barcode Lookup API (optional - https://www.barcodelookup.com/api)
BARCODE_LOOKUP_API_KEY=

# UPCitemdb API (optional trial/paid key - https://www.upcitemdb.com/)
UPCITEMDB_USER_KEY=
